{
  "version": 1,
  "setup": "python3 -m pip install --disable-pip-version-check -r tooling/requirements-ci.txt",
  "working_directory": ".",
  "commands": {
    "build": "tooling/build.sh",
    "unit-tests": "tooling/test.sh",
